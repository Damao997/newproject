# ZJYPH Windows 非 Docker 生产环境模板
# 复制为 server/.env 后替换所有 CHANGE_ME；server/.env 已被 .gitignore 排除。

NODE_ENV="production"
PORT="3100"

# 业务账号只授予 DML 权限；超级用户连接仅供迁移、备份与恢复。
DATABASE_URL="postgresql://zjyph_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5433/zjyph_prod?schema=public"
MIGRATE_DATABASE_URL="postgresql://postgres:CHANGE_ME_SUPER_PASSWORD@127.0.0.1:5433/zjyph_prod?schema=public"

# 嵌入式 PostgreSQL 生产实例
ZJYPH_DATA_DIR="D:\\ZJYPHFA\\data"
ZJYPH_PG_PORT="5433"
ZJYPH_DB_NAME="zjyph_prod"
ZJYPH_PG_PASSWORD="CHANGE_ME_SUPER_PASSWORD"

# 使用逗号分隔所有真实前端来源；严禁 *。
FRONTEND_ORIGIN="https://finance.example.com,http://SERVER_LAN_IP:8080"

JWT_SECRET="CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="CHANGE_ME_ANOTHER_RANDOM_SECRET_32_CHARS"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
PERSISTENT_LOGIN_TTL_DAYS="7"
BCRYPT_COST="12"

LOG_LEVEL="INFO"
FISCAL_START_MONTH="4"

DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-v4-flash"

ENTERPRISE_INFO_PROVIDER="mock"
ENTERPRISE_INFO_API_KEY=""
ENTERPRISE_INFO_API_BASE=""
