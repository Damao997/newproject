# ===== 数据库 =====
# 本地 PostgreSQL 连接串（生产走 Docker Secret / 环境注入）
DATABASE_URL="postgresql://yipinhui_app:CHANGE_ME@localhost:5432/yipinhui_finance?schema=public"
# 开发库端口：默认取自上方 DATABASE_URL 的端口，无需单独配置；
# 多 worktree 共用一台机器隔离开发库时，用 DB_PORT 覆盖（如 5434），此时需同步修改上方 DATABASE_URL 的端口
# DB_PORT=5432

# ===== JWT =====
# 启动时强制校验：缺失则中止启动，禁止回退默认值
# 生成方式示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="please-generate-a-strong-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="please-generate-another-strong-random-secret-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ===== 服务 =====
PORT="3001"
NODE_ENV="development"

# ===== CORS =====
# 仅允许前端来源，严禁 *
FRONTEND_ORIGIN="http://localhost:5173"

# ===== 密码哈希 =====
BCRYPT_COST="12"

# ===== 日志 =====
# DEBUG / INFO / WARN / ERROR
LOG_LEVEL="INFO"

# ===== 财年 =====
# 财年起始月（1-12）；业务为 4 月制：FY2026 = 2026-04 ~ 2027-03
# 影响本年累计/同期累计区间、财年标签、预算匹配等计算
FISCAL_START_MONTH=4

# ===== AI（DeepSeek）=====
# 单条 AI 公式生成需要有效 Key 与到 api.deepseek.com:443 的出站；未配置时该接口报错，批量规则生成不受影响
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-flash"

# ===== 邮件（SMTP，忘记密码用）=====
# 全部可选：未配置 SMTP_HOST 时忘记密码接口返回 503「邮件服务未配置」，登录等其他功能不受影响。
# 企业内部 SMTP 或 163/QQ 等公共邮箱授权码均可；端口 465 走隐式 TLS，587/25 走 STARTTLS。
# 需防火墙放行对应出站端口。MAIL_FROM 为发件人地址，启用 SMTP 时必填。
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# 开发联调开关（仅限非生产，生产环境配置将拒绝启动）：=1 时不连 SMTP，
# 把邮件写为 server/.mail-out/*.eml（可双击预览）+ 同名 .json（含验证码明文，供读码）。该目录已 gitignore。
MAIL_DEV_CAPTURE="0"
