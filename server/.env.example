# ===== 数据库 =====
# 本地 PostgreSQL 连接串（生产走 Docker Secret / 环境注入）
DATABASE_URL="postgresql://yipinhui_app:CHANGE_ME@localhost:5432/yipinhui_finance?schema=public"

# ===== JWT =====
# 启动时强制校验：缺失则中止启动，禁止回退默认值
# 生成方式示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="please-generate-a-strong-random-secret-at-least-32-chars"
JWT_REFRESH_SECRET="please-generate-another-strong-random-secret-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# ===== 服务 =====
PORT="3001"
NODE_ENV="development"

# ===== CORS =====
# 仅允许前端来源，严禁 *
FRONTEND_ORIGIN="http://localhost:5173"

# ===== 密码哈希 =====
BCRYPT_COST="12"

# ===== 日志 =====
# DEBUG / INFO / WARN / ERROR
LOG_LEVEL="INFO"

# ===== 财年 =====
# 财年起始月（1-12）；业务为 4 月制：FY2026 = 2026-04 ~ 2027-03
# 影响本年累计/同期累计区间、财年标签、预算匹配等计算
FISCAL_START_MONTH=4

# ===== AI（DeepSeek）=====
# 单条 AI 公式生成需要有效 Key 与到 api.deepseek.com:443 的出站；未配置时该接口报错，批量规则生成不受影响
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE="https://api.deepseek.com/v1"
DEEPSEEK_MODEL="deepseek-flash"
