# .env.example（编排层 / 根目录）
# 浙江壹品慧财年经营数据分析平台 — docker compose 变量模板
#
# 用法：
#   cp .env.example .env   然后用下方命令生成真实密钥替换所有 replace_me
#   ⚠️ .env 含明文密钥，已被 .gitignore 排除，严禁提交
#
# 与 server/.env 的区别（详见《部署运维规范》§五）：
#   本文件 = 编排层，供 docker compose 插值（数据库密码、备份密钥等）
#   server/.env = 应用层，仅本地开发时被后端进程直接读取
#   生产环境下后端的环境变量由 docker-compose.yml 注入，不读 server/.env

# ── 密钥生成命令 ──────────────────────────────────────────
#   openssl rand -hex 64      → JWT_SECRET / JWT_REFRESH_SECRET
#   openssl rand -base64 32   → DB_SUPER_PASSWORD / DB_APP_PASSWORD
#   openssl rand -hex 32      → BACKUP_ENCRYPTION_KEY

# ── 数据库（必填）──────────────────────────────────────────
# 超级用户：仅用于 Prisma 迁移与备份，不供应用连接
DB_SUPER_PASSWORD=replace_me_super_password
# 业务账号 yipinhui_app：应用运行时连接，仅 DML 权限（≥12 字符）
DB_APP_PASSWORD=replace_me_app_password

# ── JWT（必填，各 ≥32 字符，缺失或过短后端拒绝启动）─────────────
JWT_SECRET=replace_me_jwt_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=replace_me_jwt_refresh_secret_at_least_32_chars

# ── 备份加密（必填，≥32 字符）────────────────────────────────
BACKUP_ENCRYPTION_KEY=replace_me_backup_encryption_key_32_chars_min

# ── 前端访问地址（CORS 白名单）────────────────────────────────
# 支持逗号分隔多值；严禁通配符 *
# 例：http://192.168.1.100 或 http://192.168.1.100,http://finance.intranet
FRONTEND_ORIGIN=http://localhost

# ── DeepSeek AI（可选；留空则 AI 功能返回 503，应用仍正常启动）───
# 内网需放行出站 https://api.deepseek.com:443
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# 仅接受 deepseek-v4-flash / deepseek-v4-pro（旧名 deepseek-chat 已废弃，调用返回 400）
DEEPSEEK_MODEL=deepseek-v4-flash

# ── 业务与运维参数（可选，留空取默认）────────────────────────
# 财年起始月 1-12，影响 YTD 聚合与财年标签；业务财年为 4 月制，保持 4（勿改 1，否则财年口径静默错误）
FISCAL_START_MONTH=4
# DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
# 企业工商信息数据源：mock / tianyancha / qichacha
ENTERPRISE_INFO_PROVIDER=mock
# 企业工商查询 API 密钥与地址（provider 非 mock 时必填；不透传进容器将导致查询配置不生效）
ENTERPRISE_INFO_API_KEY=
ENTERPRISE_INFO_API_BASE=
# bcrypt 轮次，最小 12
BCRYPT_COST=12

# ── 备份保留策略（可选）──────────────────────────────────────
FULL_RETENTION_DAYS=30
WAL_RETENTION_DAYS=7
